PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/servicedesk_pro
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=8h
CLIENT_URL=http://localhost:5173
# Groq AI (https://console.groq.com/keys). Without a key the app falls back to a built-in heuristic classifier.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# SLA sweep schedule (cron). Default: every minute
SLA_CRON=* * * * *
